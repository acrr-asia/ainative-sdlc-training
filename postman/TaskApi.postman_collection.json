    {
      "name": "1. Auth (spec 0001)",
      "description": "Register, login, token handling. Rules S2, S3, S5.",
      "item": [
        {
          "name": "Register member",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now();",
                  "pm.collectionVariables.set(\"memberEmail\", `member-${id}@example.com`);",
                  "pm.collectionVariables.set(\"intruderEmail\", `intruder-${id}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test(\"Role is Member\", () => pm.expect(u.role).to.eql(\"Member\"));",
                  "pm.test(\"No password in response (S5)\", () => pm.expect(pm.response.text().toLowerCase()).to.not.include(\"password\"));",
                  "pm.collectionVariables.set(\"memberId\", u.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
