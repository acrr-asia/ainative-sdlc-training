{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=taskapi.db"
  },
  "Jwt": {
    "Issuer": "TaskApi",
    "Audience": "TaskApi",
    "LifetimeMinutes": 60
  },
  "LoginThrottle": {
    "MaxFailures": 5,
    "WindowSeconds": 60,
    "LockoutSeconds": 60
  }
}
